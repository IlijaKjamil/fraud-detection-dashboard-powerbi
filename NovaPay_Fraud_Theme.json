{
  "name": "NovaPay Fraud Intelligence",
  "dataColors": [
    "#3B82F6",
    "#22C55E",
    "#EAB308",
    "#EF4444",
    "#F97316",
    "#A855F7",
    "#06B6D4",
    "#EC4899"
  ],
  "background": "#0B1220",
  "foreground": "#E2E8F0",
  "tableAccent": "#3B82F6",
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "border": [{ "color": { "solid": { "color": "#1E2E45" } } }],
        "fontFamily": [{ "fontFamily": "Segoe UI" }],
        "fontSize": [{ "fontSize": 11 }],
        "foreground": [{ "color": { "solid": { "color": "#E2E8F0" } } }],
        "titleFontFamily": [{ "fontFamily": "Segoe UI" }],
        "titleFontSize": [{ "fontSize": 13 }],
        "titleFontColor": [{ "color": { "solid": { "color": "#E2E8F0" } } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "calloutValue": [{
          "fontSize": 28,
          "fontFamily": "Segoe UI",
          "color": { "solid": { "color": "#E2E8F0" } },
          "bold": true
        }],
        "categoryLabel": [{
          "fontSize": 11,
          "fontFamily": "Segoe UI",
          "color": { "solid": { "color": "#7B91B0" } }
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#1E2E45" } },
          "radius": 8
        }]
      }
    },
    "donutChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "legend": [{
          "show": true,
          "position": "Right",
          "fontFamily": "Segoe UI",
          "fontSize": 11,
          "color": { "solid": { "color": "#94A3B8" } }
        }],
        "dataLabels": [{
          "show": false
        }]
      }
    },
    "barChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "categoryAxis": [{
          "gridlineColor": { "solid": { "color": "#1E2E45" } },
          "fontFamily": "Segoe UI",
          "fontSize": 11,
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "axisStyle": "showTitleOnly"
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#1E2E45" } },
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "gridlineStyle": "dashed"
        }],
        "dataLabels": [{
          "show": true,
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "color": { "solid": { "color": "#E2E8F0" } }
        }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "categoryAxis": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "fontSize": 11
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#1E2E45" } },
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "gridlineStyle": "dashed"
        }],
        "dataLabels": [{
          "show": true,
          "fontSize": 10,
          "color": { "solid": { "color": "#E2E8F0" } }
        }]
      }
    },
    "columnChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "categoryAxis": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "fontSize": 11,
          "gridlineColor": { "solid": { "color": "#1E2E45" } }
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#1E2E45" } },
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "gridlineStyle": "dashed"
        }],
        "dataLabels": [{
          "show": true,
          "fontSize": 10,
          "color": { "solid": { "color": "#E2E8F0" } }
        }]
      }
    },
    "tableEx": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "values": [{
          "fontColor": { "solid": { "color": "#E2E8F0" } },
          "fontFamily": "Segoe UI",
          "fontSize": 11,
          "background": { "solid": { "color": "#162032" } }
        }],
        "header": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "background": { "solid": { "color": "#111C2E" } },
          "bold": true,
          "outline": "None"
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontalColor": { "solid": { "color": "#1E2E45" } },
          "rowPadding": 5,
          "outlineColor": { "solid": { "color": "#1E2E45" } }
        }]
      }
    },
    "matrix": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "header": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "background": { "solid": { "color": "#111C2E" } },
          "fontSize": 10,
          "bold": true
        }],
        "values": [{
          "fontColor": { "solid": { "color": "#E2E8F0" } },
          "fontSize": 11
        }],
        "grid": [{
          "gridHorizontalColor": { "solid": { "color": "#1E2E45" } },
          "gridVertical": false,
          "rowPadding": 5
        }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#111C2E" } } }],
        "data": [{
          "fontColor": { "solid": { "color": "#E2E8F0" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI"
        }],
        "header": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "fontSize": 11,
          "background": { "solid": { "color": "#111C2E" } }
        }],
        "border": [{
          "color": { "solid": { "color": "#1E2E45" } }
        }]
      }
    },
    "shape": {
      "*": {
        "fill": [{ "color": { "solid": { "color": "#111C2E" } } }],
        "border": [{
          "color": { "solid": { "color": "#1E2E45" } }
        }]
      }
    },
    "textbox": {
      "*": {
        "border": [{ "show": false }]
      }
    },
    "lineChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#162032" } } }],
        "categoryAxis": [{
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "gridlineColor": { "solid": { "color": "#1E2E45" } }
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#1E2E45" } },
          "fontColor": { "solid": { "color": "#7B91B0" } },
          "gridlineStyle": "dashed"
        }],
        "legend": [{
          "fontColor": { "solid": { "color": "#94A3B8" } }
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }],
        "wallpaper": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#E2E8F0"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI",
      "color": "#E2E8F0"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#7B91B0"
    }
  }
}
